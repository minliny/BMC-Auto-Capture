    "/executor/v1/plans/{plan_id}": {
      "get": {
        "summary": "Get Plan",
        "description": "Get plan summary.\n\nHandles both:\n  - numeric local plan IDs: no query params needed\n  - external plan IDs: requires excelHash query param",
        "operationId": "get_plan_executor_v1_plans__plan_id__get",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          },
          {
            "name": "excelHash",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Optional Excel SHA-256 hash. When provided, the query is validated against the plan's bound Excel hash.",
              "default": "",
              "title": "Excelhash"
            },
            "description": "Optional Excel SHA-256 hash. When provided, the query is validated against the plan's bound Excel hash."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanStatusResponse"
                }
