    "/executor/v1/config/excel:path": {
      "post": {
        "summary": "Set Latest Excel Path",
        "description": "Set latest Excel by executor-local path (local debug only).\n\nUses ExcelConfigStore.activate_from_local_path() which copies the\nfile into executor_state/configs/by_hash/ and writes latest.json.\nHistorical .runtime/configs/latest.xlsx files are migrated by\nExcelConfigStore when present.",
        "operationId": "set_latest_excel_path_executor_v1_config_excel_path_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExcelPathRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExcelConfigAcceptResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/executor/v1/config/excel": {
      "post": {
        "summary": "Upload Excel",
        "description": "Upload Excel file from remote Windows client (multipart/form-data).\n\nUses ExcelConfigStore.activate_from_upload() which saves to\nexecutor_state/configs/by_hash/ and atomically writes latest.json.\nDoes NOT write to .runtime/configs/latest.xlsx.",
        "operationId": "upload_excel_executor_v1_config_excel_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_excel_executor_v1_config_excel_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExcelConfigAcceptResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/executor/v1/config/latest": {
      "get": {
        "summary": "Get Latest Config",
        "description": "Return info about the latest Excel config, or hasLatest=false.\n\nReads from latest.json via ExcelConfigStore.\nFalls back to process-local state created by set_latest_excel().",
