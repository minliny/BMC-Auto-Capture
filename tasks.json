    "计算节点光口状态查询测试": {
      "task_type": "SSH",
      "execution_mode": "SSH_CMD",
      "command_or_url": "screen-length 0 temporary\ndisplay interface brief\ndisplay interface 200GHL1/2/48",
      "timeout_seconds": 60,
      "retry_count": 0,
      "rules": [
        {
          "rule_name": "check_no_interface_down",
          "rule_type": "advanced",
          "enabled": false,
          "actions": [
            {
              "action_type": "assert_text",
              "value": "up",
              "_note": "接口状态应包含 up，如果接口 down 则规则 FAIL"
            }
          ],
          "_note": "需在真实设备验证后启用。预期端口清单待业务方确认。"
        }
      ],
      "output_dir_template": "{任务序号} {任务名称}/{设备分类}",
      "image_name_template": "{带内管理IP}-{设备名称}",
      "capture_ready_conditions": [],
      "evidence_checkpoints": [
        {
          "name": "no_interface_down",
          "type": "not_contains_any",
          "target": "down||DOWN||error-down",
          "severity": "ERROR"
        },
        {
          "name": "has_up_port",
          "type": "text_contains",
          "target": "up",
          "severity": "WARNING"
        }
      ]
    },
