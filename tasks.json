    "A3 BMC首页截图": {
      "task_type": "BMC",
      "execution_mode": "BMC_URL",
      "command_or_url": "/UI/Static/#/navigate/home",
      "timeout_seconds": 60,
      "retry_count": 0,
      "rules": [
        {
          "rule_name": "bmc_page_no_alarm",
          "rule_type": "advanced",
          "enabled": false,
          "actions": [
            {
              "action_type": "assert_text",
              "value": "正常",
              "_note": "BMC 页面不应包含告警关键字。需在真实设备上确认 BMC 正常状态下的文本特征。"
            }
          ],
          "_note": "通用 BMC 页面无告警检查。需在真实设备验证后启用。"
        }
      ],
