    "计算节点L1交换网络端口查询测试": {
      "task_type": "SSH",
      "execution_mode": "SSH_CMD",
      "command_or_url": "display interface brief | include up",
      "timeout_seconds": 60,
      "retry_count": 0,
      "rules": [
        {
          "name": "端口状态检查",
          "desc": "L1交换机所有UP端口应正常，不应出现down状态",
          "checks": [
            {
              "type": "text_exists",
              "target": "up",
              "desc": "输出包含UP端口"
            },
            {
              "type": "text_not_exists",
              "target": "down",
              "desc": "不存在down端口"
            },
            {
              "type": "text_not_exists",
              "target": "DOWN",
              "desc": "不存在DOWN端口"
            }
          ]
        }
      ],
      "output_dir_template": "{任务序号} {任务名称}/{设备分类}",
      "image_name_template": "{带内管理IP}-{设备名称}"
    },
